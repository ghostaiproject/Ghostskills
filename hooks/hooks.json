{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/ghostskills.py", "hook", "session-start"],
            "timeout": 5
          }
        ]
      }
    ]
  }
}
